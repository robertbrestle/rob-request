@page "/"
@implements IDisposable

<PageTitle>RobRequest - API Client</PageTitle>

<MudGrid Spacing="2">
    <MudItem lg="6" md="12">
        <RequestPanel @ref="_requestPanel"
                      OnResponseReceived="OnResponseReceived"
                      OnSendingChanged="OnSendingChanged"/>
    </MudItem>
    <MudItem lg="6" md="12">
        <ResponsePanel Response="_response" IsSending="_isSending"/>
    </MudItem>
</MudGrid>

<SectionContent SectionName="Drawer">
    <MudStack Spacing="0">
        @* Environment *@
        <EnvironmentSelector/>

        @* Collections *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-2" Style="cursor: pointer;"
                  @onclick="() => _collectionsOpen = !_collectionsOpen">
            <MudIcon Icon="@(_collectionsOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                     Size="Size.Small"/>
            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-1"/>
            <MudText Typo="Typo.subtitle1"><b>Collections</b></MudText>
        </MudStack>
        <MudCollapse Expanded="_collectionsOpen">
            <CollectionSidebar OnRequestSelected="OnCollectionRequestSelected"/>
        </MudCollapse>

        <MudDivider Class="my-1"/>

        @* History *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-2" Style="cursor: pointer;"
                  @onclick="() => _historyOpen = !_historyOpen">
            <MudIcon Icon="@(_historyOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                     Size="Size.Small"/>
            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mr-1"/>
            <MudText Typo="Typo.subtitle1"><b>History</b></MudText>
        </MudStack>
        <MudCollapse Expanded="_historyOpen">
            <HistorySidebar OnRequestSelected="OnHistoryItemSelected"/>
        </MudCollapse>
    </MudStack>
</SectionContent>

@code {

    [CascadingParameter] public required MainLayout Layout { get; set; }

    private RequestPanel? _requestPanel;
    private HttpResponseModel? _response;
    private bool _isSending;
    private bool _collectionsOpen = true;
    private bool _historyOpen = true;

    protected override async Task OnInitializedAsync()
    {
        await Layout.DrawerEnabledToggleAsync(true);
    }

    private void OnResponseReceived(HttpResponseModel response)
    {
        _response = response;
        StateHasChanged();
    }

    private void OnSendingChanged(bool isSending)
    {
        _isSending = isSending;
        StateHasChanged();
    }

    private void OnHistoryItemSelected(HistoryItem item)
    {
        if (item.Request != null)
        {
            _requestPanel?.LoadRequest(item.Request);
        }

        if (item.Response != null)
        {
            _response = item.Response;
            StateHasChanged();
        }
    }

    private void OnCollectionRequestSelected(CollectionRequestModel collectionRequest)
    {
        _requestPanel?.LoadRequest(collectionRequest.Request);
        _response = null;
        StateHasChanged();
    }

    public void Dispose()
    {
    }

}
