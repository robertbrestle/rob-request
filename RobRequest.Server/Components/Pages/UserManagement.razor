@code {
    [CascadingParameter] public required MainLayout Layout { get; set; }

    private List<User> _users = new();
    private List<User> _pendingApprovals = new();
    private List<UserGroup> _groups = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Layout.DrawerEnabledToggleAsync(true);
        _groups = await UserService.GetAllGroupsAsync();
        await RefreshUsersAsync();
    }

    private async Task RefreshUsersAsync()
    {
        _loading = true;
        _users = await UserService.GetAllUsersAsync();
        _pendingApprovals = await UserService.GetPendingApprovalsAsync();
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CreateUserDialog>
        {
            { x => x.Groups, _groups }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateUserDialog>("Create User", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await RefreshUsersAsync();
            Snackbar.Add("User created successfully.", Severity.Success);
        }
    }

    private async Task ApproveUserAsync(string userId)
    {
        var success = await UserService.ApproveUserAsync(userId);
        if (success)
        {
            Snackbar.Add("User approved.", Severity.Success);
            await RefreshUsersAsync();
        }
    }

    private async Task ToggleEnabledAsync(string userId)
    {
        var success = await UserService.ToggleEnabledAsync(userId);
        if (success)
        {
            Snackbar.Add("User status updated.", Severity.Success);
            await RefreshUsersAsync();
        }
    }

    private async Task ResetPasswordAsync(string userId, string username)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Reset Password",
            $"Reset the password for user \"{username}\"? A new password will be generated.",
            yesText: "Reset", cancelText: "Cancel");

        if (confirm == true)
        {
            var newPassword = await UserService.ResetPasswordAsync(userId);
            if (newPassword != null)
            {
                await DialogService.ShowMessageBoxAsync(
                    "New Password",
                    (MarkupString)$"The new password for <strong>{username}</strong> is:<br/><br/><code>{newPassword}</code><br/><br/>Please share this securely with the user.",
                    yesText: "OK");
            }
        }
    }

    private async Task ChangeGroupAsync(string userId, string username, string currentGroupId)
    {
        var parameters = new DialogParameters<ChangeGroupDialog>
        {
            { x => x.UserId, userId },
            { x => x.Username, username },
            { x => x.CurrentGroupId, currentGroupId },
            { x => x.Groups, _groups }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ChangeGroupDialog>("Change User Group", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await RefreshUsersAsync();
            Snackbar.Add("User group updated successfully.", Severity.Success);
        }
    }

    private async Task DeleteUserAsync(string userId, string username)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete User",
            (MarkupString)$"<strong>Warning:</strong> This will permanently delete user \"{username}\" and all their data (collections, environments, history, settings). This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            var success = await UserService.DeleteUserAsync(userId);
            if (success)
            {
                Snackbar.Add($"User \"{username}\" deleted.", Severity.Success);
                await RefreshUsersAsync();
            }
        }
    }

}
