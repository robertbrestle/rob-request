@page "/settings"
@rendermode InteractiveServer
@inject SettingsService SettingsService

<PageTitle>Settings - RobRequest</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Settings</MudText>

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">General</MudText>

        <MudStack Spacing="3">
            <MudSwitch T="bool"
                       Value="_settings.DarkMode"
                       ValueChanged="OnDarkModeChanged"
                       Label="Dark Mode"
                       Color="Color.Primary" />

            <MudNumericField T="int"
                             @bind-Value="_settings.DefaultTimeoutSeconds"
                             Label="Default Request Timeout (seconds)"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="300" />

            <MudNumericField T="int"
                             @bind-Value="_settings.MaxHistoryItems"
                             Label="Max History Items"
                             Variant="Variant.Outlined"
                             Min="10"
                             Max="10000" />

            <MudSwitch T="bool"
                       @bind-Value="_settings.AutoFormatJson"
                       Label="Auto-format JSON responses"
                       Color="Color.Primary" />

            <MudSwitch T="bool"
                       @bind-Value="_settings.FollowRedirects"
                       Label="Follow Redirects"
                       Color="Color.Primary" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SaveSettings"
                       StartIcon="@Icons.Material.Filled.Save">
                Save Settings
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">About</MudText>
        <MudText Typo="Typo.body1">
            <strong>RobRequest</strong> — A lightweight REST API client built with .NET 10 Blazor Interactive Server and MudBlazor.
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-2">
            Version 1.0.0
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    
    [CascadingParameter] public required MainLayout Layout { get; set; }
    
    private UserSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        await Layout.DrawerEnabledToggleAsync(false);
        _settings = await SettingsService.GetSettingsAsync();
    }

    private async Task OnDarkModeChanged(bool value)
    {
        _settings.DarkMode = value;
        await SettingsService.UpdateSettingsAsync(_settings);
    }

    private async Task SaveSettings()
    {
        await SettingsService.UpdateSettingsAsync(_settings);
    }
}
