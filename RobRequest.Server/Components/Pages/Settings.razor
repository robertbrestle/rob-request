@page "/settings"
@inject ImportExportService ImportExportService
@inject CollectionService CollectionService
@inject HistoryService HistoryService
@inject AuthService AuthService
@inject CurrentUserService CurrentUser
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SettingsService SettingsService
@implements IDisposable

<PageTitle>RobRequest - Settings</PageTitle>

<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" Size="Size.Large"/>
                    <MudText Typo="Typo.h5">Your Settings</MudText>
                    <MudSpacer/>
                    <MudIconButton Icon="@Icons.Custom.Uncategorized.Empty" Disabled="true" Ripple="false"/>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" GutterBottom="true">General</MudText>
            <MudStack Spacing="3">
                <MudStack Row="true">
                    <MudSwitch T="bool"
                               @bind-Value="_settings.DarkMode"
                               @bind-Value:after="SaveSettings"
                               Label="Dark Mode"
                               Color="Color.Primary"/>
                </MudStack>

                <MudText Typo="Typo.body2">
                    Update your account password.
                </MudText>
                <MudStack Row="true" Spacing="3">
                    <MudTextField @bind-Value="_newPassword"
                                  Label="New Password"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordInputIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  HelperText="Minimum 8 characters"/>

                    <MudTextField @bind-Value="_confirmPassword"
                                  Label="Confirm New Password"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordInputIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"/>

                    <MudStack Class="pt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   OnClick="ChangePasswordAsync"
                                   StartIcon="@Icons.Material.Filled.LockReset"
                                   Disabled="@_changingPassword">
                            @if (_changingPassword)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                <span>Updating…</span>
                            }
                            else
                            {
                                <span>Change Password</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Requests</MudText>
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudNumericField T="int"
                                     @bind-Value="_settings.DefaultTimeoutSeconds"
                                     @bind-Value:after="SaveSettings"
                                     Label="Default Request Timeout (seconds)"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Max="300"/>

                    <MudNumericField T="int"
                                     @bind-Value="_settings.MaxHistoryItems"
                                     @bind-Value:after="SaveSettings"
                                     Label="Max History Items"
                                     Variant="Variant.Outlined"
                                     Min="10"
                                     Max="10000"/>
                </MudStack>

                <MudStack Row="true" Justify="Justify.SpaceAround">
                    <MudSwitch T="bool"
                               @bind-Value="_settings.AutoFormatJson"
                               @bind-Value:after="SaveSettings"
                               Label="Auto-format JSON responses"
                               Color="Color.Primary"/>

                    <MudSwitch T="bool"
                               @bind-Value="_settings.FollowRedirects"
                               @bind-Value:after="SaveSettings"
                               Label="Follow Redirects"
                               Color="Color.Primary"/>

                    <MudSwitch T="bool"
                               @bind-Value="_settings.ValidateSslCertificates"
                               @bind-Value:after="SaveSettings"
                               Label="Validate SSL Certificates"
                               Color="Color.Primary"/>
                </MudStack>


                <MudDivider Class="my-2"/>

                <MudText Typo="Typo.h6" GutterBottom="true">Clear Your Data</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-2">
                    Permanently delete your saved data. These actions cannot be undone.
                </MudText>

                <MudStack Row="true" Spacing="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="ClearCollectionsAsync"
                               StartIcon="@Icons.Material.Filled.Folder">
                        Clear Collections
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="ClearEnvironmentsAsync"
                               StartIcon="@Icons.Material.Filled.Dns">
                        Clear Environments
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="ClearHistoryAsync"
                               StartIcon="@Icons.Material.Filled.History">
                        Clear History
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Export</MudText>
            <MudStack>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Select collections, environments, and/or history items to export as a JSON file.
                </MudText>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudSelect T="string" Label="Collections" MultiSelection="true"
                               @bind-SelectedValues="_selectedCollectionIds"
                               MultiSelectionTextFunc="@(ids => string.Join(", ", ids.Select(id => _collections.FirstOrDefault(c => c.Id == id)?.Name ?? id)))"
                               Variant="Variant.Outlined" Dense="true"
                               Disabled="@(!_collections.Any())">
                        @foreach (var col in _collections)
                        {
                            <MudSelectItem T="string" Value="@col.Id">@col.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string" Label="Environments" MultiSelection="true"
                               @bind-SelectedValues="_selectedEnvironmentIds"
                               MultiSelectionTextFunc="@(ids => string.Join(", ", ids.Select(id => _environments.FirstOrDefault(e => e.Id == id)?.Name ?? id)))"
                               Variant="Variant.Outlined" Dense="true"
                               Disabled="@(!_environments.Any())">
                        @foreach (var env in _environments)
                        {
                            <MudSelectItem T="string" Value="@env.Id">@env.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>

                <MudCheckBox T="bool"
                             @bind-Value="_exportAllHistory"
                             Label="@($"Export all history ({_historyItems.Count} items)")"
                             Color="Color.Primary"
                             Disabled="@(!_historyItems.Any())"/>

                <MudStack Row="true" Spacing="2" Justify="Justify.FlexStart">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="ExportAsync"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               Disabled="@(!HasExportSelection || _exporting)">
                        @if (_exporting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                            <span>Exporting…</span>
                        }
                        else
                        {
                            <span>Export to JSON</span>
                        }
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Import</MudText>
            <MudStack>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Upload a previously exported RobRequest JSON file to import collections, environments, and history.
                </MudText>
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    If an imported collection or environment has the same name as an existing one, a timestamp will be
                    appended to avoid conflicts.
                </MudAlert>

                <MudStack Row="true" Spacing="2" Justify="Justify.FlexStart">
                    <MudFileUpload T="IBrowserFile" Accept=".json" OnFilesChanged="OnImportFileChanged">
                        <CustomContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.UploadFile"
                                       OnClick="@context.OpenFilePickerAsync">
                                Select JSON File
                            </MudButton>
                        </CustomContent>
                        <SelectedTemplate>
                            @if (context == null)
                            {
                                <MudText>No file selected</MudText>
                            }
                        </SelectedTemplate>
                    </MudFileUpload>
                </MudStack>

                @if (_importPreview != null)
                {
                    <MudAlert Severity="Severity.Normal" Dense="true">
                        <strong>@_importFileName</strong> (format v@(_importPreview.FormatVersion),
                        exported @_importPreview.ExportedAt.ToString("g") UTC)
                    </MudAlert>

                    <MudStack Row="true">
                        @if (_importPreview.Collections is { Count: > 0 })
                        {
                            <MudChip T="string" Icon="@Icons.Material.Filled.Folder" Variant="Variant.Outlined">
                                @_importPreview.Collections.Count collection@(_importPreview.Collections.Count == 1 ? "" : "s")
                            </MudChip>
                        }
                        @if (_importPreview.Environments is { Count: > 0 })
                        {
                            <MudChip T="string" Icon="@Icons.Material.Filled.Dns" Variant="Variant.Outlined">
                                @_importPreview.Environments.Count environment@(_importPreview.Environments.Count == 1 ? "" : "s")
                            </MudChip>
                        }
                        @if (_importPreview.History is { Count: > 0 })
                        {
                            <MudChip T="string" Icon="@Icons.Material.Filled.History" Variant="Variant.Outlined">
                                @_importPreview.History.Count histor@(_importPreview.History.Count == 1 ? "y" : "ies")
                            </MudChip>
                        }
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexStart">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="ImportAsync"
                                   StartIcon="@Icons.Material.Filled.FileUpload"
                                   Disabled="@_importing">
                            @if (_importing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                <span>Importing…</span>
                            }
                            else
                            {
                                <span>Import</span>
                            }
                        </MudButton>
                    </MudStack>
                }

                @if (_importError != null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_importError</MudAlert>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    [CascadingParameter] public required MainLayout Layout { get; set; }

    private UserSettings _settings = new();

    // Export state
    private List<CollectionModel> _collections = new();
    private List<EnvironmentModel> _environments = new();
    private IReadOnlyList<HistoryItem> _historyItems = Array.Empty<HistoryItem>();
    private IReadOnlyCollection<string> _selectedCollectionIds = Array.Empty<string>();
    private IReadOnlyCollection<string> _selectedEnvironmentIds = Array.Empty<string>();
    private bool _exporting;

    private bool _exportAllHistory;

    private bool HasExportSelection =>
        _selectedCollectionIds.Any() || _selectedEnvironmentIds.Any() || _exportAllHistory;

    // Security state
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _changingPassword;
    private bool _showPassword;
    private InputType _passwordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string _passwordInputIcon => _showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    // Import state
    private RobRequestExport? _importPreview;
    private string? _importFileName;
    private string? _importJson;
    private string? _importError;
    private bool _importing;

    protected override async Task OnInitializedAsync()
    {
        await Layout.DrawerEnabledToggleAsync(true, false);
        _settings = await SettingsService.GetSettingsAsync();

        _collections = await CollectionService.GetCollectionTreeAsync();
        _environments = await EnvironmentService.GetAllEnvironmentsAsync();
        _historyItems = await HistoryService.GetHistoryAsync(1000);
    }

    private async Task SaveSettings()
    {
        await SettingsService.UpdateSettingsAsync(_settings);
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add("Password cannot be empty.", Severity.Error);
            return;
        }

        if (_newPassword.Length < 8)
        {
            Snackbar.Add("Password must be at least 8 characters.", Severity.Error);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Error);
            return;
        }

        if (CurrentUser.UserId == null)
        {
            Snackbar.Add("User not authenticated.", Severity.Error);
            return;
        }

        _changingPassword = true;
        try
        {
            var success = await AuthService.ChangePasswordAsync(CurrentUser.UserId, _newPassword);
            if (success)
            {
                Snackbar.Add("Password changed successfully.", Severity.Success);
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
            }
            else
            {
                Snackbar.Add("Failed to change password. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _changingPassword = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_exporting)
            return;
        _exporting = true;
        try
        {
            var historyIds = _exportAllHistory
                ? _historyItems.Select(h => h.Id).ToList()
                : new List<string>();

            var export = await ImportExportService.BuildExportAsync(
                _selectedCollectionIds.ToList(),
                _selectedEnvironmentIds.ToList(),
                historyIds);

            var json = ImportExportService.SerializeExport(export);
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var fileName = $"robrequest-export-{DateTime.Now:yyyy-MM-dd}.json";

            using var stream = new System.IO.MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await Js.InvokeVoidAsync("downloadFileFromStream", fileName, "application/json", streamRef);
            Snackbar.Add("Export downloaded successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task OnImportFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await OnImportFileSelected(file);
    }

    private async Task OnImportFileSelected(IBrowserFile file)
    {
        _importPreview = null;
        _importError = null;
        _importJson = null;

        try
        {
            _importFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            _importJson = await reader.ReadToEndAsync();

            var preview = ImportExportService.DeserializeExport(_importJson);
            if (preview == null)
            {
                _importError = "Failed to parse the JSON file. Please ensure it is a valid RobRequest export.";
                return;
            }

            if (preview.FormatVersion != "1")
            {
                _importError = $"Unsupported format version: {preview.FormatVersion}. Only version \"1\" is supported.";
                return;
            }

            _importPreview = preview;
        }
        catch (Exception ex)
        {
            _importError = $"Error reading file: {ex.Message}";
        }
    }

    private async Task ClearHistoryAsync()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Clear History",
            (MarkupString)"<strong>Warning:</strong> This will permanently delete all request history. This action cannot be undone.",
            yesText: "Delete All", cancelText: "Cancel");

        if (result == true)
        {
            await HistoryService.ClearHistoryAsync();
            _historyItems = await HistoryService.GetHistoryAsync(1000);
            _exportAllHistory = false;
            Snackbar.Add("All history cleared.", Severity.Success);
        }
    }

    private async Task ClearCollectionsAsync()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Clear Collections",
            (MarkupString)"<strong>Warning:</strong> This will permanently delete all collections and their saved requests. This action cannot be undone.",
            yesText: "Delete All", cancelText: "Cancel");

        if (result == true)
        {
            await CollectionService.ClearAllCollectionsAsync();
            _collections = await CollectionService.GetCollectionTreeAsync();
            _selectedCollectionIds = Array.Empty<string>();
            Snackbar.Add("All collections cleared.", Severity.Success);
        }
    }

    private async Task ClearEnvironmentsAsync()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Clear Environments",
            (MarkupString)"<strong>Warning:</strong> This will permanently delete all environments and their variables. This action cannot be undone.",
            yesText: "Delete All", cancelText: "Cancel");

        if (result == true)
        {
            await EnvironmentService.ClearAllEnvironmentsAsync();
            _environments = await EnvironmentService.GetAllEnvironmentsAsync();
            _selectedEnvironmentIds = Array.Empty<string>();
            Snackbar.Add("All environments cleared.", Severity.Success);
        }
    }

    private async Task ImportAsync()
    {
        if (_importPreview == null || _importJson == null) return;

        _importing = true;
        _importError = null;
        try
        {
            var data = ImportExportService.DeserializeExport(_importJson);
            if (data == null)
            {
                _importError = "Failed to parse import data.";
                return;
            }

            var result = await ImportExportService.ImportAsync(data);

            if (!result.Success)
            {
                _importError = string.Join(" ", result.Errors);
                Snackbar.Add("Import completed with errors.", Severity.Warning);
            }
            else
            {
                Snackbar.Add(result.Summary, Severity.Success);
            }

            // Refresh lists
            _collections = await CollectionService.GetCollectionTreeAsync();
            _environments = await EnvironmentService.GetAllEnvironmentsAsync();
            _historyItems = await HistoryService.GetHistoryAsync(1000);

            _importPreview = null;
            _importJson = null;
            _importFileName = null;
        }
        catch (Exception ex)
        {
            _importError = $"Import failed: {ex.Message}";
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    public void Dispose()
    {
        Snackbar?.Dispose();
    }

}
