@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout MinimalLayout
@inject NavigationManager Navigation

<PageTitle>RobRequest - Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center floating-container">
    <MudPaper Elevation="3" Class="pa-8" Style="width: 100%;">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Large" Color="Color.Primary"/>
            <MudText Typo="Typo.h4">RobRequest</MudText>
            <MudText Typo="Typo.body1" Color="Color.Default">Create a new account</MudText>

            @if (_error != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="w-100">
                    @_error
                </MudAlert>
            }

            <form method="post" action="/api/auth/register" id="registerForm" style="width: 100%;">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="_username"
                                  Label="Username"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  InputType="InputType.Text"
                                  name="username"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"/>

                    <MudTextPasswordField @bind-Value="_password" Immediate="true"
                                          Label="Password" Name="password" HelperText="Minimum 8 characters"/>
                    <MudTextPasswordField @bind-Value="_confirmPassword" Immediate="true"
                                          Label="Confirm Password" Name="confirmPassword"/>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large">
                        Register
                    </MudButton>
                </MudStack>
            </form>

            <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Info" Dense="true"
                      Variant="Variant.Outlined" Class="w-100">
                After registering, an administrator must approve your account before you can sign in.
            </MudAlert>

            <MudLink Href="/login" Typo="Typo.body2">
                Already have an account? Sign in
            </MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var errorParam = query["error"];
        if (!string.IsNullOrEmpty(errorParam))
            _error = errorParam;
    }

}
