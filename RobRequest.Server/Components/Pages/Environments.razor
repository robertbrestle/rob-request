@page "/environments"
@implements IDisposable
@inject ApiService ApiService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>RobRequest - Environments</PageTitle>

<SectionContent SectionName="Drawer">
    <MudStack Spacing="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-2">
            <MudText Typo="Typo.h6">Environments</MudText>
            <MudSpacer/>
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           OnClick="CreateEnvironment"
                           title="New environment"/>
        </MudStack>

        <MudStack Spacing="2" Class="pa-2">
            <MudTextField T="string"
                          @bind-Value="_searchQuery"
                          Placeholder="Search..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="SearchEnvironments"
                          Class="mb-2"/>
        </MudStack>

        @if (_environments.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center" Class="pa-4">
                No environments yet. Create one to get started.
            </MudText>
        }
        else
        {
            <MudStack Spacing="0" Style="max-height: calc(100vh - 280px); overflow-y: auto;">
                @foreach (var env in _environments)
                {
                    var isSelected = _selectedEnvironmentId == env.Id;
                    var isActive = EnvironmentService.ActiveEnvironmentId == env.Id;

                    <MudStack Row="true" AlignItems="AlignItems.Center"
                              Class="@($"pr-1 pt-1 pb-1 {(isSelected ? "mud-theme-primary" : "")}")"
                              Style="padding-left: 8px; cursor: pointer; border-radius: 4px;"
                              @onclick="() => SelectEnvironment(env.Id)">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small"
                                 Color="@(isActive ? Color.Success : Color.Default)"/>
                        <MudText Typo="Typo.body2"
                                 Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;">
                            @env.Name
                        </MudText>
                        @if (isActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                     Style="@(GetChipStyle(isSelected))">
                                Active
                            </MudChip>
                        }
                        @if (env.Variables.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Style="@(GetChipStyle(isSelected))">
                                @env.Variables.Count
                            </MudChip>
                        }
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                         OnClick="() => DeleteEnvironmentFromList(env)">
                                Delete
                            </MudMenuItem>
                        </MudMenu>
                    </MudStack>
                }
            </MudStack>
        }
    </MudStack>
</SectionContent>

<MudGrid Spacing="2">
    @* Right: Detail Panel *@
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4" Style="min-height: 100%;">
            @if (_selectedEnvironment != null)
            {
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" Size="Size.Large"/>
                        <MudText Typo="Typo.h5">@_selectedEnvironment.Name</MudText>
                        <MudSpacer/>
                        @if (EnvironmentService.ActiveEnvironmentId == _selectedEnvironment.Id)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                        }
                        else
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="SetActiveEnvironment">
                                Set Active
                            </MudButton>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="DeleteSelectedEnvironment"
                                       title="Delete Environment"/>
                    </MudStack>

                    <MudDivider/>

                    @* Editable Fields *@
                    <MudTextField T="string"
                                  Value="_selectedEnvironment.Name"
                                  ValueChanged="@(async v =>
                                                {
                                                    _selectedEnvironment.Name = v;
                                                    await SaveAsync();
                                                })"
                                  Label="Environment Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  DebounceInterval="500"/>

                    <MudTextField T="string"
                                  Value="_selectedEnvironment.Description"
                                  ValueChanged="@(async v =>
                                                {
                                                    _selectedEnvironment.Description = v;
                                                    await SaveAsync();
                                                })"
                                  Label="Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="1"
                                  Sizing="InputSizing.Auto"
                                  MaxLines="20"
                                  Immediate="true"
                                  DebounceInterval="500"/>

                    <MudDivider/>

                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-3">
                        <MudTabPanel Text="Variables" Icon="@Icons.Material.Filled.List">
                            <MudStack Spacing="3">

                                <MudText Typo="Typo.caption" Color="Color.Default">
                                    Use <code>@("{{variableName}}")</code> syntax in URLs, headers, body, and auth
                                    fields to substitute variables.
                                </MudText>

                                @if (_selectedEnvironment.Variables.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
                                        No variables defined. Add variables to use in your requests.
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudSimpleTable Dense="true" Hover="true" Elevation="0"
                                                    Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;">
                                        <thead>
                                        <tr>
                                            <th style="width: 50px;">On</th>
                                            <th>Key</th>
                                            <th>Value</th>
                                            <th style="width: 70px;">Secret</th>
                                            <th style="width: 50px;"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var variable in _selectedEnvironment.Variables)
                                        {
                                            <tr>
                                                <td>
                                                    <MudCheckBox T="bool"
                                                                 Value="variable.Enabled"
                                                                 ValueChanged="@(async v =>
                                                                               {
                                                                                   variable.Enabled = v;
                                                                                   await SaveAsync();
                                                                               })"
                                                                 Size="Size.Small" Dense="true"/>
                                                </td>
                                                <td>
                                                    <MudTextField T="string"
                                                                  Value="variable.Key"
                                                                  ValueChanged="@(async v =>
                                                                                {
                                                                                    variable.Key = v;
                                                                                    await SaveAsync();
                                                                                })"
                                                                  Variant="Variant.Text"
                                                                  Margin="Margin.Dense"
                                                                  Placeholder="variable_name"
                                                                  Immediate="true"
                                                                  DebounceInterval="500"/>
                                                </td>
                                                <td>
                                                    <MudTextField T="string"
                                                                  Value="variable.Value"
                                                                  ValueChanged="@(async v =>
                                                                                {
                                                                                    variable.Value = v;
                                                                                    await SaveAsync();
                                                                                })"
                                                                  Variant="Variant.Text"
                                                                  Margin="Margin.Dense"
                                                                  Placeholder="value"
                                                                  InputType="@(variable.IsSecret ? InputType.Password : InputType.Text)"
                                                                  Immediate="true"
                                                                  DebounceInterval="500"/>
                                                </td>
                                                <td>
                                                    <MudCheckBox T="bool"
                                                                 Value="variable.IsSecret"
                                                                 ValueChanged="@(async v =>
                                                                               {
                                                                                   variable.IsSecret = v;
                                                                                   await SaveAsync();
                                                                               })"
                                                                 Size="Size.Small" Dense="true"/>
                                                </td>
                                                <td>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   OnClick="() => RemoveVariable(variable)"/>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </MudSimpleTable>
                                }

                                <MudButton StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="AddVariable">
                                    Add Variable
                                </MudButton>
                            </MudStack>
                        </MudTabPanel>
                        <MudTabPanel Text="Authentication" Icon="@Icons.Material.Filled.Security">
                            <MudStack Spacing="3">
                                <MudSelect T="AuthType"
                                           Value="_selectedEnvironment.Auth.AuthType"
                                           ValueChanged="@(async v =>
                                                         {
                                                             _selectedEnvironment.Auth.AuthType = v;
                                                             await SaveAsync();
                                                         })"
                                           Label="Auth Type" Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    <MudSelectItem Value="AuthType.None">No Auth</MudSelectItem>
                                    <MudSelectItem Value="AuthType.Bearer">Bearer Token</MudSelectItem>
                                    <MudSelectItem Value="AuthType.Basic">Basic Auth</MudSelectItem>
                                    <MudSelectItem Value="AuthType.ApiKey">API Key</MudSelectItem>
                                    <MudSelectItem Value="AuthType.OAuth2">OAuth 2.0</MudSelectItem>
                                </MudSelect>

                                @switch (_selectedEnvironment.Auth.AuthType)
                                {
                                    case AuthType.Bearer:
                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.AuthToken"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Token"
                                                      Placeholder="Enter bearer token"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      InputType="InputType.Password"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>
                                        break;

                                    case AuthType.Basic:
                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.AuthUsername"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Username"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>
                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.AuthPassword"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Password"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      InputType="InputType.Password"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>
                                        break;

                                    case AuthType.ApiKey:
                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.ApiKeyName"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Key Name"
                                                      Placeholder="e.g. X-API-Key"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>
                                        <MudTextPasswordField @bind-Value="_selectedEnvironment.Auth.ApiKeyValue"
                                                              @bind-Value:after="SaveAsync"
                                                              Label="Key Value"/>
                                        <MudSelect T="ApiKeyLocation"
                                                   @bind-Value="_selectedEnvironment.Auth.ApiKeyLocation"
                                                   @bind-Value:after="SaveAsync"
                                                   Label="Add to"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem Value="ApiKeyLocation.Header">Header</MudSelectItem>
                                            <MudSelectItem Value="ApiKeyLocation.QueryParam">Query Param</MudSelectItem>
                                        </MudSelect>
                                        break;

                                    case AuthType.OAuth2:
                                        <MudSelect T="OAuth2GrantType"
                                                   @bind-Value="_selectedEnvironment.Auth.OAuth2GrantType"
                                                   @bind-Value:after="SaveAsync"
                                                   Label="Grant Type"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem Value="OAuth2GrantType.ClientCredentials">Client
                                                Credentials
                                            </MudSelectItem>
                                        </MudSelect>

                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.OAuth2TokenUrl"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Token URL"
                                                      Placeholder="https://auth.example.com/oauth2/token"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>

                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.OAuth2ClientId"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Client ID"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>

                                        <MudTextPasswordField @bind-Value="_selectedEnvironment.Auth.OAuth2ClientSecret"
                                                              @bind-Value:after="SaveAsync"
                                                              Label="Client Secret"/>

                                        <MudTextField T="string"
                                                      @bind-Value="_selectedEnvironment.Auth.OAuth2Scope"
                                                      @bind-Value:after="SaveAsync"
                                                      Label="Scope"
                                                      Placeholder="e.g. read write"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      DebounceInterval="500"/>

                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                            <MudSwitch T="bool"
                                                       @bind-Value="_selectedEnvironment.Auth.OAuth2AutoRefresh"
                                                       @bind-Value:after="SaveAsync"
                                                       Color="Color.Primary" Label="Auto-token refresh"/>
                                            @if (_selectedEnvironment.Auth.OAuth2TokenExpiresAt.HasValue)
                                            {
                                                var remaining = _selectedEnvironment.Auth.OAuth2TokenExpiresAt.Value - DateTime.Now;
                                                var isExpired = remaining.TotalSeconds <= 0;
                                                <MudText Typo="Typo.caption"
                                                         Color="@(isExpired ? Color.Error : remaining.TotalSeconds < 60 ? Color.Warning : Color.Success)">
                                                    @(isExpired ? "Token expired" : $"Token valid for: {FormatTimeSpan(remaining)}")
                                                </MudText>
                                            }
                                        </MudStack>

                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudTextField T="string"
                                                          Value="_selectedEnvironment.Auth.AuthToken"
                                                          ReadOnly="true"
                                                          Label="Access Token"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="Token will appear here after fetching"
                                                          Adornment="Adornment.End"
                                                          AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                                          OnAdornmentClick="CopyToken"/>

                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       OnClick="GetOAuth2Token"
                                                       Disabled="_isGettingToken">
                                                @if (_isGettingToken)
                                                {
                                                    <MudProgressCircular Class="ms-n1" Size="Size.Small"
                                                                         Indeterminate="true"/>
                                                    <MudText Class="ms-2">Getting Token...</MudText>
                                                }
                                                else
                                                {
                                                    <MudText>Get Token</MudText>
                                                }
                                            </MudButton>
                                        </MudStack>
                                        break;
                                }
                            </MudStack>
                        </MudTabPanel>
                    </MudTabs>

                    @* Metadata *@
                    <MudDivider Class="my-2"/>
                    <MudStack Row="true" Spacing="4">
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            Created: @_selectedEnvironment.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            Updated: @_selectedEnvironment.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    </MudStack>
                </MudStack>
            }
            else
            {
                @* No selection *@
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center"
                          Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Large"
                             Color="Color.Default" Style="font-size: 64px; opacity: 0.3;"/>
                    <MudText Typo="Typo.h6" Color="Color.Default" Align="Align.Center">
                        Select an environment to view its details
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center">
                        Choose an environment from the list on the left, or create a new one.
                    </MudText>
                </MudStack>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    [CascadingParameter] public required MainLayout Layout { get; set; }

    private List<EnvironmentModel> _environments = new();
    private string _searchQuery = string.Empty;
    private string? _selectedEnvironmentId;
    private EnvironmentModel? _selectedEnvironment;

    private bool _isGettingToken;

    private async Task SaveAsync()
    {
        if (_selectedEnvironment == null) return;
        await EnvironmentService.UpdateEnvironmentAsync(_selectedEnvironment);
    }

    private async Task CopyToken()
    {
        if (_selectedEnvironment == null || string.IsNullOrEmpty(_selectedEnvironment.Auth.AuthToken)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _selectedEnvironment.Auth.AuthToken);
        Snackbar.Add("Token copied to clipboard", Severity.Info);
    }

    private async Task<bool> GetOAuth2Token()
    {
        if (_selectedEnvironment == null) return false;
        if (string.IsNullOrWhiteSpace(_selectedEnvironment.Auth.OAuth2TokenUrl))
        {
            Snackbar.Add("Token URL is required.", Severity.Error);
            return false;
        }

        _isGettingToken = true;
        StateHasChanged();

        try
        {
            var tempRequest = new HttpRequestModel
            {
                Auth =
                {
                    OAuth2TokenUrl = await EnvironmentService.SubstituteVariablesAsync(_selectedEnvironment.Auth.OAuth2TokenUrl),
                    OAuth2ClientId = await EnvironmentService.SubstituteVariablesAsync(_selectedEnvironment.Auth.OAuth2ClientId),
                    OAuth2ClientSecret = await EnvironmentService.SubstituteVariablesAsync(_selectedEnvironment.Auth.OAuth2ClientSecret),
                    OAuth2Scope = await EnvironmentService.SubstituteVariablesAsync(_selectedEnvironment.Auth.OAuth2Scope),
                    OAuth2GrantType = _selectedEnvironment.Auth.OAuth2GrantType
                }
            };

            var result = await ApiService.GetOAuth2TokenAsync(tempRequest);
            _selectedEnvironment.Auth.AuthToken = result.AccessToken;
            _selectedEnvironment.Auth.OAuth2TokenExpiresAt = result.ExpiresIn.HasValue
                ? DateTime.Now.AddSeconds(result.ExpiresIn.Value)
                : null;

            await SaveAsync();
            Snackbar.Add("Token retrieved and saved.", Severity.Info);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error retrieving token: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _isGettingToken = false;
            StateHasChanged();
        }
    }

    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        if (ts.TotalMinutes >= 1)
            return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    private System.Threading.Timer? _uiUpdateTimer;

    protected override async Task OnInitializedAsync()
    {
        await Layout.DrawerEnabledToggleAsync(true);
        EnvironmentService.OnEnvironmentChanged += OnEnvironmentsChanged;
        _uiUpdateTimer = new System.Threading.Timer(_ => { InvokeAsync(StateHasChanged); }, null, 1000, 1000);
        await LoadEnvironments();

        // load first environment
        if (_environments.Count > 0)
        {
            var active = _environments.FirstOrDefault(x => x.Id == EnvironmentService.ActiveEnvironmentId);
            await SelectEnvironment(active?.Id ?? _environments[0].Id);
            SetActiveEnvironment();
        }
    }

    private async void OnEnvironmentsChanged()
    {
        await LoadEnvironments();
        if (_selectedEnvironmentId != null)
        {
            await LoadSelectedEnvironment();
        }

        await InvokeAsync(StateHasChanged);
    }

    private string GetChipStyle(bool isSelected) => isSelected ? "color:white; border-color:white;" : string.Empty;

    private async Task LoadEnvironments()
    {
        _environments = string.IsNullOrWhiteSpace(_searchQuery)
            ? await EnvironmentService.GetAllEnvironmentsAsync()
            : await EnvironmentService.SearchEnvironmentsAsync(_searchQuery);
    }

    private async Task LoadSelectedEnvironment()
    {
        if (_selectedEnvironmentId == null)
        {
            _selectedEnvironment = null;
            return;
        }

        _selectedEnvironment = await EnvironmentService.GetEnvironmentAsync(_selectedEnvironmentId);
    }

    private async Task SelectEnvironment(string environmentId)
    {
        _selectedEnvironmentId = environmentId;
        await LoadSelectedEnvironment();
    }

    private async Task SearchEnvironments(string query)
    {
        _searchQuery = query;
        await LoadEnvironments();
    }

    private async Task CreateEnvironment()
    {
        var parameters = new DialogParameters<NameInputDialog>
        {
            { x => x.Label, "Environment name" },
            { x => x.Value, string.Empty }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NameInputDialog>("New Environment", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false && result.Data is string name && !string.IsNullOrWhiteSpace(name))
        {
            var created = await EnvironmentService.CreateEnvironmentAsync(name);
            await LoadEnvironments();
            await SelectEnvironment(created.Id);
        }
    }

    private void SetActiveEnvironment()
    {
        if (_selectedEnvironment == null) return;
        EnvironmentService.ActiveEnvironmentId = _selectedEnvironment.Id;
    }

    private async Task DeleteSelectedEnvironment()
    {
        if (_selectedEnvironment == null) return;

        var result = await DialogService.ShowMessageBoxAsync(
            "Delete Environment",
            $"Are you sure you want to delete \"{_selectedEnvironment.Name}\" and all its variables?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            await EnvironmentService.DeleteEnvironmentAsync(_selectedEnvironment.Id);
            _selectedEnvironmentId = null;
            _selectedEnvironment = null;
            await LoadEnvironments();
        }
    }

    private async Task DeleteEnvironmentFromList(EnvironmentModel env)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Delete Environment",
            $"Are you sure you want to delete \"{env.Name}\" and all its variables?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            if (_selectedEnvironmentId == env.Id)
            {
                _selectedEnvironmentId = null;
                _selectedEnvironment = null;
            }

            await EnvironmentService.DeleteEnvironmentAsync(env.Id);
            await LoadEnvironments();
        }
    }

    private async Task AddVariable()
    {
        if (_selectedEnvironment == null) return;
        _selectedEnvironment.Variables.Add(new EnvironmentVariable());
        await SaveAsync();
    }

    private async Task RemoveVariable(EnvironmentVariable variable)
    {
        if (_selectedEnvironment == null) return;
        _selectedEnvironment.Variables.Remove(variable);
        await SaveAsync();
    }

    public void Dispose()
    {
        EnvironmentService.OnEnvironmentChanged -= OnEnvironmentsChanged;
        _uiUpdateTimer?.Dispose();
    }

}
