@using System.Security.Claims
@inherits LayoutComponentBase
@inject SettingsService SettingsService
@inject CurrentUserService CurrentUser
@implements IDisposable

<MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<UserInitializer>
<CascadingValue Value="this">
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            @if (_isDrawerEnabled)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="DrawerToggle"
                               aria-label="toggle drawer"/>
            }
            <MudIcon Icon="@Icons.Material.Filled.Api" Class="mx-2"/>
            <MudLink Href="/" Color="Color.Inherit">
                <MudText Typo="Typo.h6" Class="mr-4">
                    RobRequest
                </MudText>
            </MudLink>
            <MudSpacer/>
            <MudContainer MaxWidth="MaxWidth.ExtraSmall">
                <SectionOutlet SectionName="EnvironmentSelector"/>
            </MudContainer>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Filled.Folder"
                             Href="/collections">
                    Collections
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Dns"
                             Href="/environments">
                    Environments
                </MudMenuItem>
                <MudDivider/>
                <MudMenuItem Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                             OnClick="ToggleDarkMode">
                    Theme
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                             Href="/settings">
                    Settings
                </MudMenuItem>
                <AuthorizeView Policy="Admin">
                    <Authorized>
                        <MudDivider/>
                        <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings"
                                     Href="/admin/users">
                            User Management
                        </MudMenuItem>
                    </Authorized>
                </AuthorizeView>
                <MudDivider/>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                             Href="/api/auth/logout"
                             ForceLoad="true">
                    Logout (@CurrentUser.Username)
                </MudMenuItem>
            </MudMenu>
        </MudAppBar>

        @if (_isDrawerEnabled)
        {
            <MudDrawer @bind-Open="_isDrawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Width="300px">
                <SectionOutlet SectionName="Drawer"/>
            </MudDrawer>
        }

        <MudMainContent>
            @Body
        </MudMainContent>
    </MudLayout>
</CascadingValue>
</UserInitializer>

@code {

    private bool _isDrawerOpen = true;
    private bool _isDrawerEnabled = true;
    private bool _isDarkMode = true;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _isDarkMode = settings.DarkMode;
        SettingsService.OnSettingsChanged += OnSettingsChanged;

        await Task.CompletedTask;
    }

    private void DrawerToggle()
    {
        _isDrawerOpen = !_isDrawerOpen;
    }

    public async Task DrawerEnabledToggleAsync(bool enabled)
    {
        _isDrawerEnabled = enabled;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnSettingsChanged()
    {
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            _isDarkMode = settings.DarkMode;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // ignored
        }
    }

    public bool IsDarkMode() => _isDarkMode;
    public bool IsDrawerEnabled() => _isDrawerEnabled;

    private async Task ToggleDarkMode()
    {
        var settings = await SettingsService.GetSettingsAsync();
        settings.DarkMode = !settings.DarkMode;
        await SettingsService.UpdateSettingsAsync(settings);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SettingsService.OnSettingsChanged -= OnSettingsChanged;
    }

}