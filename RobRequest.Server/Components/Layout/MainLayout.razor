@inherits RobRequest.Server.Components.Layout.Bases.MainLayoutBase

<MudThemeProvider @bind-IsDarkMode="IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<UserInitializer>
    <CascadingValue Value="this">
        <MudLayout>
            <MudAppBar Elevation="1" Dense="true">
                @if (IsDrawerEnabled)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Inherit"
                                   Edge="Edge.Start"
                                   OnClick="DrawerToggle"
                                   aria-label="toggle drawer"/>
                }
                <MudLink Href="/" Color="Color.Inherit">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudImage Src="/favicon.png" Height="24"/>
                        <MudText Typo="Typo.h6" Class="mr-4">
                            RobRequest
                        </MudText>
                    </MudStack>
                </MudLink>
                <MudSpacer/>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Folder"
                                 Href="/collections">
                        Collections
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Dns"
                                 Href="/environments">
                        Environments
                    </MudMenuItem>
                    <MudDivider/>
                    <MudMenuItem Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                 OnClick="ToggleDarkMode">
                        Theme
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                 Href="/settings">
                        Settings
                    </MudMenuItem>
                    <AuthorizeView Policy="Admin">
                        <Authorized>
                            <MudDivider/>
                            <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings"
                                         Href="/admin/users">
                                User Management
                            </MudMenuItem>
                        </Authorized>
                    </AuthorizeView>
                    <MudDivider/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                 Href="/api/auth/logout"
                                 ForceLoad="true">
                        Logout (@CurrentUser.Username)
                    </MudMenuItem>
                </MudMenu>
            </MudAppBar>

            @if (IsDrawerEnabled)
            {
                <MudDrawer @bind-Open="IsDrawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Width="300px">
                    <SectionOutlet SectionName="Drawer"/>
                </MudDrawer>
            }

            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
</UserInitializer>