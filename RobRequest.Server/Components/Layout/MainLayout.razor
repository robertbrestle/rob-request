@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase
@inject SettingsService SettingsService
@implements IDisposable

<MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle"/>
        <MudIcon Icon="@Icons.Material.Filled.Api" Class="mr-2"/>
        <MudText Typo="Typo.h6" Class="mr-4">RobRequest</MudText>
        <MudSpacer/>
        <SectionOutlet SectionName="EnvironmentSelector"/>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode"
                       Class="ml-2"/>
        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                       Color="Color.Inherit"
                       Href="/settings"
                       Class="ml-1"/>
    </MudAppBar>

    
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Width="320px">
        <SectionOutlet SectionName="Drawer"/>
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>



@code {

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _isDarkMode = settings.DarkMode;
        SettingsService.OnSettingsChanged += OnSettingsChanged;

        await Task.CompletedTask;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async void OnSettingsChanged()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _isDarkMode = settings.DarkMode;
        await InvokeAsync(StateHasChanged);
    }

    public bool IsDarkMode() => _isDarkMode;

    private async Task ToggleDarkMode()
    {
        var settings = await SettingsService.GetSettingsAsync();
        settings.DarkMode = !settings.DarkMode;
        await SettingsService.UpdateSettingsAsync(settings);
    }

    public void Dispose()
    {
        SettingsService.OnSettingsChanged -= OnSettingsChanged;
    }
}