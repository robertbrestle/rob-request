@inherits RobRequest.Server.Components.Layout.Bases.MainLayoutBase

<MudThemeProvider @bind-IsDarkMode="IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<UserInitializer>
    <CascadingValue Value="this">
        <MudLayout>
            <NavDrawer IsEnabled="IsDrawerEnabled"
                       @bind-IsDrawerOpen="IsDrawerOpen"
                       IsDarkMode="IsDarkMode"
                       OnToggleDarkMode="ToggleDarkMode"
                       OnDrawerToggle="DrawerToggle"/>

            <MudMainContent Class="mt-0 pt-0">
                @Body
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
</UserInitializer>