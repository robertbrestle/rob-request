@using RobRequest.Server.Components.Shared.Navigation
@inherits RobRequest.Server.Components.Layout.Bases.MainLayoutBase

<MudThemeProvider Theme="Theme" @bind-IsDarkMode="IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@if (IsInitialized)
{
    <CascadingValue Value="this">
        <MudLayout>
            <NavDrawer IsEnabled="IsDrawerEnabled"
                       @bind-IsDrawerOpen="IsDrawerOpen"
                       IsDarkMode="IsDarkMode"
                       IsDrawerSectionEnabled="IsDrawerSectionEnabled"
                       IsNavMenuEnabled="IsNavMenuEnabled"
                       OnToggleDarkMode="ToggleDarkMode"
                       OnDrawerToggle="DrawerToggle"
                       OnAboutDialog="AboutDialog"/>
            <MudMainContent Class="mt-0 pt-0">
                @Body
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
}