<MudTextField T="string" Value="@Value" ValueChanged="OnValueChanged" Immediate="@Immediate"
              Label="@Label" name="@Name" HelperText="@HelperText"
              Variant="@Variant" InputType="@_passwordInput" Margin="@Margin"
              Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="PlaintextToggle"
              AdornmentAriaLabel="Show Secret"/>

@code {

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Field";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Immediate { get; set; }

    private async Task OnValueChanged(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private bool _isShow;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    void PlaintextToggle()
    {
        @if (_isShow)
        {
            _isShow = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isShow = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

}