@implements IDisposable

<MudPaper Elevation="1" Class="pa-4">
    @if (Response == null && !IsSending)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 200px;">
            <MudText Typo="Typo.h6" Color="Color.Default" Align="Align.Center">
                Enter a URL and click Send to get a response
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center">
                Or press Ctrl+Enter to send the request
            </MudText>
        </MudStack>
    }
    else if (IsSending)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 200px;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large"/>
            <MudText Typo="Typo.body1" Class="mt-3">Sending request...</MudText>
            <MudWatch @ref="_watch" Interval="TimeSpan.FromSeconds(1)" Mode="WatchMode.StopWatch" 
                      ShowHour="false" ShowMinute="true" ShowSecond="true" ShowMillisecond="false" 
                      Delimiter=":" Typo="Typo.body1" TypoMillisecond="Typo.body1" />
        </MudStack>
    }
    else if (Response != null)
    {
        @* Status Bar *@
        <StatusIndicator Response="Response"/>

        <MudDivider Class="my-3"/>

        @* Response Tabs *@
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabButtonsClass="pa-3" ActivePanelIndex="1"
                 TabPanelsClass="pt-2">
            @* Headers Tab *@
            <MudTabPanel Text="Headers" BadgeData="@Response.Headers.Count.ToString()" BadgeColor="Color.Info">
                <MudStack Spacing="2">
                    <MudStack Row="true" Spacing="1" Class="mb-2" AlignItems="AlignItems.Center">
                        <MudTextField T="string"
                                      @bind-Value="_headerSearch"
                                      Placeholder="Filter headers..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Style="max-width: 300px;"
                                      Immediate="true"/>
                        <MudSpacer/>
                        <div>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="CopyHeaders">
                                Copy as JSON
                            </MudButton>
                        </div>
                    </MudStack>

                    <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0">
                        <thead>
                        <tr>
                            <th style="cursor: pointer;" @onclick="@(() => SortHeaders("key"))">
                                Name
                                @if (_headerSortField == "key")
                                {
                                    <MudIcon
                                        Icon="@(_headerSortAsc ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                        Size="Size.Small"/>
                                }
                            </th>
                            <th style="cursor: pointer;" @onclick="@(() => SortHeaders("value"))">
                                Value
                                @if (_headerSortField == "value")
                                {
                                    <MudIcon
                                        Icon="@(_headerSortAsc ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                        Size="Size.Small"/>
                                }
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var header in GetFilteredHeaders())
                        {
                            <tr>
                                <td><strong>@header.Key</strong></td>
                                <td style="word-break: break-all;">@header.Value</td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                </MudStack>
            </MudTabPanel>
            @* Body Tab *@
            <MudTabPanel Text="Body">
                <MudStack Spacing="2">
                    @if (!string.IsNullOrEmpty(Response.ErrorMessage))
                    {
                        @if (!string.IsNullOrEmpty(Response.StackTrace))
                        {
                            <MonacoEditor Id="response-body-editor"
                                          Value="@Response.StackTrace"
                                          Language="@GetMonacoLanguage()"
                                          ReadOnly="true"
                                          IsDarkMode="Layout.IsDarkMode"
                                          CssClass="response-body-editor"/>
                        }
                    }
                    else if (!string.IsNullOrEmpty(Response.Body))
                    {
                        @if (IsLargeResponse())
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 200px;" Spacing="3">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Style="font-size: 3rem;"/>
                                <MudText Typo="Typo.h6" Align="Align.Center">
                                    Response body is too large to display (@Response.FormattedSize)
                                </MudText>
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                    Responses over 5 MB are not rendered to preserve application stability.
                                </MudAlert>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           OnClick="DownloadResponseBody">
                                    Download Response Body
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MonacoEditor Id="response-body-editor"
                                          Value="@GetDisplayBody()"
                                          Language="@GetMonacoLanguage()"
                                          ReadOnly="true"
                                          IsDarkMode="Layout.IsDarkMode"
                                          CssClass="response-body-editor"/>
                        }
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="1" Class="mb-2" Justify="Justify.Center">
                            <MudText>No response body</MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudPaper>

@code {

    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private SettingsService SettingsService { get; set; } = default!;

    [CascadingParameter] public required MainLayout Layout { get; set; }
    [Parameter] public HttpResponseModel? Response { get; set; }
    [Parameter] public bool IsSending { get; set; }

    private string _headerSearch = string.Empty;
    private string _headerSortField = "key";
    private bool _headerSortAsc = true;
    private MudWatch? _watch;
    private bool _isWatchStarted;
    private UserSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetSettingsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        switch (IsSending)
        {
            case true when _watch != null && !_isWatchStarted:
                _isWatchStarted = true;
                _watch.Start();
                break;
            case false:
                _isWatchStarted = false;
                break;
        }
    }

    private string GetMonacoLanguage()
    {
        var contentType = Response?.ContentType ?? string.Empty;
        if (contentType.Contains("json", StringComparison.OrdinalIgnoreCase))
            return "json";
        if (contentType.Contains("xml", StringComparison.OrdinalIgnoreCase))
            return "xml";
        if (contentType.Contains("html", StringComparison.OrdinalIgnoreCase))
            return "html";
        if (contentType.Contains("javascript", StringComparison.OrdinalIgnoreCase))
            return "javascript";
        if (contentType.Contains("css", StringComparison.OrdinalIgnoreCase))
            return "css";
        return "plaintext";
    }

    private const long LargeResponseThresholdBytes = 5 * 1024 * 1024; // 5 MB

    private bool IsLargeResponse()
    {
        return Response != null && System.Text.Encoding.UTF8.GetByteCount(Response.Body) > LargeResponseThresholdBytes;
    }

    private async Task DownloadResponseBody()
    {
        if (Response == null) return;

        var fileName = $"response-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
        var contentType = string.IsNullOrEmpty(Response.ContentType) ? "text/plain" : Response.ContentType;
        var bytes = System.Text.Encoding.UTF8.GetBytes(Response.Body);
        var base64 = Convert.ToBase64String(bytes);
        await Js.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private string GetDisplayBody()
    {
        if (Response == null) return string.Empty;

        if (_settings.AutoFormatJson && GetMonacoLanguage() == "json" && !string.IsNullOrEmpty(Response.Body))
        {
            try
            {
                var doc = System.Text.Json.JsonDocument.Parse(Response.Body);
                return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            }
            catch
            {
                // Not valid JSON — fall through to raw body
            }
        }

        return Response.Body;
    }

    private IEnumerable<HeaderItem> GetFilteredHeaders()
    {
        if (Response == null) return Enumerable.Empty<HeaderItem>();

        var headers = Response.Headers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_headerSearch))
        {
            headers = headers.Where(h =>
                h.Key.Contains(_headerSearch, StringComparison.OrdinalIgnoreCase) ||
                h.Value.Contains(_headerSearch, StringComparison.OrdinalIgnoreCase));
        }

        headers = _headerSortField switch
        {
            "key" => _headerSortAsc ? headers.OrderBy(h => h.Key) : headers.OrderByDescending(h => h.Key),
            "value" => _headerSortAsc ? headers.OrderBy(h => h.Value) : headers.OrderByDescending(h => h.Value),
            _ => headers
        };

        return headers;
    }

    private void SortHeaders(string field)
    {
        if (_headerSortField == field)
            _headerSortAsc = !_headerSortAsc;
        else
        {
            _headerSortField = field;
            _headerSortAsc = true;
        }
    }

    private async Task CopyHeaders()
    {
        if (Response != null)
        {
            var dict = Response.Headers.ToDictionary(h => h.Key, h => h.Value);
            var json = System.Text.Json.JsonSerializer.Serialize(dict, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", json);
            Snackbar.Add("Copied to clipboard", Severity.Success);
        }
    }

    public void Dispose()
    {
        Snackbar.Dispose();
        Layout.Dispose();
    }

}
