@inject HistoryService HistoryService
@inject IDialogService DialogService
@using RobRequest.Shared.Models.History
@implements IDisposable

<MudStack Spacing="2" Class="pa-2">
    @* Header *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        @* Search *@
        <MudTextField T="string"
                      @bind-Value="_searchQuery"
                      Placeholder="Search history..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="SearchHistory"/>
        @if (_history.Count > 0)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="ClearHistory"
                           title="Clear all history"
                           aria-label="clear request history"/>
        }
    </MudStack>
    
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
    }
    else if (_history.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center" Class="pa-4">
            No requests yet
        </MudText>
    }
    else
    {
        <MudList T="string" Dense="true" Class="history-list">
            @foreach (var item in _history)
            {
                var id = item.Id;
                <MudListItem T="string" OnClick="@(() => OnRequestSelected.InvokeAsync(item))" Class="history-item">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <HttpMethodChip Method="@item.Method" IsError="@(item.StatusCode == 0)"/>
                            <HttpStatusChip StatusCode="@item.StatusCode" Variant="Variant.Outlined"/>
                            <MudSpacer/>
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteHistoryItem(id))"
                                           title="Delete request history"
                                           aria-label="delete request history"/>
                        </MudStack>
                        <MudText Typo="Typo.caption"
                                 Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 250px;">
                            @TruncateUrl(item.Url)
                        </MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                            </MudText>
                            <MudSpacer/>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @item.ResponseTimeMs ms
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
        @if (_isLoadingMore)
        {
            <div class="d-flex justify-center pa-2">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small"/>
            </div>
        }
        else if (_hasMore)
        {
            <div class="d-flex justify-center pa-2">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="LoadMore">Load More
                </MudButton>
            </div>
        }
    }
</MudStack>

@code {

    [Parameter] public EventCallback<HistoryItem> OnRequestSelected { get; set; }

    private const int PageSize = 10;

    private readonly List<HistoryItem> _history = new();
    private string _searchQuery = string.Empty;
    private bool _isLoading = true;
    private bool _isLoadingMore;
    private bool _hasMore = true;

    protected override async Task OnInitializedAsync()
    {
        HistoryService.OnHistoryChanged += OnHistoryChanged;
        // delay loading to prevent UI lag
        await Task.Delay(100);
        await LoadHistory();
        _isLoading = false;
    }

    private async void OnHistoryChanged()
    {
        await ReloadPreservingCount();
        await InvokeAsync(StateHasChanged);
    }

    // Resets the list and loads the first page. Used on initial load and search.
    private async Task LoadHistory()
    {
        _history.Clear();
        _hasMore = true;
        await LoadMore();
    }

    // Loads the next page and appends it to the current list.
    private async Task LoadMore()
    {
        if (_isLoadingMore || !_hasMore) return;
        _isLoadingMore = true;
        try
        {
            var page = string.IsNullOrWhiteSpace(_searchQuery)
                ? await HistoryService.GetHistoryAsync(PageSize, _history.Count)
                : await HistoryService.SearchHistoryAsync(_searchQuery, PageSize, _history.Count);
            _history.AddRange(page);
            _hasMore = page.Count == PageSize;
        }
        finally
        {
            _isLoadingMore = false;
        }
    }

    // Reloads the items currently in view in a single query (e.g. after an item
    // is added, deleted or cleared) so the user keeps their scroll depth instead
    // of snapping back to the first page.
    private async Task ReloadPreservingCount()
    {
        var count = Math.Max(PageSize, _history.Count);
        var page = string.IsNullOrWhiteSpace(_searchQuery)
            ? await HistoryService.GetHistoryAsync(count)
            : await HistoryService.SearchHistoryAsync(_searchQuery, count);
        _history.Clear();
        _history.AddRange(page);
        _hasMore = page.Count == count;
    }

    private async Task SearchHistory(string query)
    {
        _searchQuery = query;
        await LoadHistory();
    }

    private async Task ClearHistory()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Delete History",
            "Are you sure you want to delete all request history?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            await HistoryService.ClearHistoryAsync();
        }
    }

    private async Task DeleteHistoryItem(string id)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Delete History",
            "Are you sure you want to delete this request history item?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            await HistoryService.RemoveFromHistoryAsync(id);
        }
    }

    private string TruncateUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        try
        {
            var uri = new Uri(url);
            return uri.PathAndQuery.Length > 40
                ? uri.Host + uri.PathAndQuery[..37] + "..."
                : uri.Host + uri.PathAndQuery;
        }
        catch
        {
            return url.Length > 50 ? url[..47] + "..." : url;
        }
    }

    public void Dispose()
    {
        HistoryService.OnHistoryChanged -= OnHistoryChanged;
    }

}
