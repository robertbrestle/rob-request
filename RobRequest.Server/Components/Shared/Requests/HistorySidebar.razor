@inject HistoryService HistoryService
@implements IDisposable

<MudStack Spacing="2" Class="pa-2">
    <!-- Search -->
    <MudTextField T="string"
                  @bind-Value="_searchQuery"
                  Placeholder="Search history..."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  DebounceInterval="300"
                  OnDebounceIntervalElapsed="SearchHistory"/>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudSpacer/>
        @if (_history.Count > 0)
        {
            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="ClearHistory"
                           title="Clear all history"/>
        }
    </MudStack>

    @if (_history.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center" Class="pa-4">
            No requests yet
        </MudText>
    }
    else
    {
        <MudList T="string" Dense="true" Class="history-list"
                 Style="max-height: calc(100vh - 250px); overflow-y: auto;">
            @foreach (var item in _history)
            {
                <MudListItem T="string" OnClick="@(() => OnRequestSelected.InvokeAsync(item))" Class="history-item">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <HttpMethodChip Method="@item.Method" IsError="@(item.StatusCode == 0)"/>
                            <HttpStatusChip StatusCode="@item.StatusCode" Variant="Variant.Outlined"/>
                            <MudSpacer/>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @item.ResponseTimeMs ms
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption"
                                 Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 250px;">
                            @TruncateUrl(item.Url)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            @item.Timestamp.ToString("HH:mm:ss")
                        </MudText>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudStack>

@code {

    [Parameter] public EventCallback<HistoryItem> OnRequestSelected { get; set; }

    private IReadOnlyList<HistoryItem> _history = Array.Empty<HistoryItem>();
    private string _searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        HistoryService.OnHistoryChanged += OnHistoryChanged;
        await LoadHistory();
    }

    private async void OnHistoryChanged()
    {
        await LoadHistory();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadHistory()
    {
        _history = string.IsNullOrWhiteSpace(_searchQuery)
            ? await HistoryService.GetHistoryAsync()
            : await HistoryService.SearchHistoryAsync(_searchQuery);
    }

    private async Task SearchHistory(string query)
    {
        _searchQuery = query;
        await LoadHistory();
    }

    private async Task ClearHistory()
    {
        await HistoryService.ClearHistoryAsync();
    }

    private string TruncateUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        try
        {
            var uri = new Uri(url);
            return uri.PathAndQuery.Length > 40
                ? uri.Host + uri.PathAndQuery[..37] + "..."
                : uri.Host + uri.PathAndQuery;
        }
        catch
        {
            return url.Length > 50 ? url[..47] + "..." : url;
        }
    }

    public void Dispose()
    {
        HistoryService.OnHistoryChanged -= OnHistoryChanged;
    }

}
