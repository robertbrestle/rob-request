@using MudBlazor.Utilities
@inject ApiService ApiService
@inject HistoryService HistoryService
@inject CollectionService CollectionService
@inject EnvironmentService EnvironmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudHotkey Key="JsKey.Enter" KeyModifiers="[JsKeyModifier.ControlRight]" OnHotkeyPressed="SendRequest"/>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <!-- Request URL Bar -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MethodSelector @bind-Value="_request.Method" IsDarkMode="Layout.IsDarkMode"/>
        <MudTextField T="string"
                      @ref="_urlField"
                      Value="_request.Url"
                      ValueChanged="OnUrlValueChanged"
                      Placeholder="Enter request URL (e.g. https://api.example.com/endpoint)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="flex: 1;"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Air"
                      AdornmentAriaLabel="clean query parameters"
                      OnAdornmentClick="OnUrlChanged"
                      Immediate="true"
                      DebounceInterval="300"
                      OnKeyDown="OnSendRequest"/>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendRequest"
                   Disabled="_isSending"
                   Size="Size.Large"
                   title="Send request">
            @if (_isSending)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <span>Sending...</span>
            }
            else
            {
                <span>Send</span>
            }
        </MudButton>

        @if (_isSending)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                           Color="Color.Error"
                           OnClick="CancelRequest"
                           Size="Size.Medium"
                           title="Cancel request"/>
        }
        <MudIconButton Icon="@Icons.Material.Filled.SaveAs"
                       Color="Color.Secondary"
                       OnClick="SaveToCollection"
                       Size="Size.Medium"
                       title="Save to collection"/>
    </MudStack>

    @if (_showUrlPreview && !string.IsNullOrEmpty(_resolvedUrlPreview))
    {
        <MudText Typo="Typo.caption" Color="Color.Inherit" Class="ml-1 mb-1"
                 Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Class="mr-1"
                     Style="vertical-align: middle; font-size: 14px;"/>
            @_resolvedUrlPreview
        </MudText>
    }

    <!-- Request Tabs -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabButtonsClass="pa-3">
        <!-- Params Tab -->
        <MudTabPanel Text="Params" BadgeData="@GetParamsBadge()" BadgeColor="Color.Primary">
            <KeyValueEditor TItem="QueryParamItem"
                            Items="_request.QueryParams"
                            ItemsChanged="OnQueryParamsChanged"
                            KeyLabel="Parameter"
                            ValueLabel="Value"
                            GetKey="@(i => i.Key)"
                            GetValue="@(i => i.Value)"
                            GetEnabled="@(i => i.Enabled)"
                            SetKey="@((i, v) => i.Key = v)"
                            SetValue="@((i, v) => i.Value = v)"
                            SetEnabled="@((i, v) => i.Enabled = v)"
                            Style="max-height: calc(40vh); overflow-y: auto;"/>
        </MudTabPanel>

        <!-- Headers Tab -->
        <MudTabPanel Text="Headers" BadgeData="@GetHeadersBadge()" BadgeColor="Color.Primary">
            <MudStack Spacing="2">
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(() => AddCommonHeader("Content-Type", "application/json"))">
                        Content-Type: JSON
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(() => AddCommonHeader("Accept", "application/json"))">
                        Accept: JSON
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(() => AddCommonHeader("Authorization", "Bearer "))">
                        Authorization
                    </MudButton>
                </MudStack>
                <KeyValueEditor TItem="HeaderItem"
                                Items="_request.Headers"
                                ItemsChanged="OnHeadersChanged"
                                KeyLabel="Header Name"
                                ValueLabel="Header Value"
                                GetKey="@(i => i.Key)"
                                GetValue="@(i => i.Value)"
                                GetEnabled="@(i => i.Enabled)"
                                SetKey="@((i, v) => i.Key = v)"
                                SetValue="@((i, v) => i.Value = v)"
                                SetEnabled="@((i, v) => i.Enabled = v)"
                                Style="max-height: calc(40vh); overflow-y: auto;"/>
            </MudStack>
        </MudTabPanel>

        <!-- Body Tab -->
        <MudTabPanel Text="Body">
            <MudStack Spacing="2">
                <MudRadioGroup T="string" @bind-Value="_request.BodyType">
                    <MudRadio Value="@("none")" Color="Color.Primary" Dense="true">None</MudRadio>
                    <MudRadio Value="@("json")" Color="Color.Primary" Dense="true">JSON</MudRadio>
                    <MudRadio Value="@("form-data")" Color="Color.Primary" Dense="true">Form Data</MudRadio>
                    <MudRadio Value="@("text")" Color="Color.Primary" Dense="true">Raw Text</MudRadio>
                    <MudRadio Value="@("xml")" Color="Color.Primary" Dense="true">XML</MudRadio>
                </MudRadioGroup>

                @if (_request.BodyType != "none")
                {
                    @if (_request.BodyType == "json")
                    {
                        <MudStack Row="true" Spacing="1" Class="mb-1">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.FormatAlignLeft"
                                       OnClick="FormatJson">
                                Format JSON
                            </MudButton>
                        </MudStack>
                        <MonacoEditor Id="request-body-editor-json"
                                      Value="@_request.Body"
                                      ValueChanged="OnBodyChanged"
                                      Language="json"
                                      ReadOnly="false"
                                      IsDarkMode="Layout.IsDarkMode"
                                      ShowMinimap="false"
                                      CssClass="request-body-editor"/>
                    }
                    else if (_request.BodyType == "form-data")
                    {
                        <KeyValueEditor TItem="FormDataItem"
                                        Items="_request.FormData"
                                        ItemsChanged="OnFormDataChanged"
                                        KeyLabel="Field Name"
                                        ValueLabel="Field Value"
                                        GetKey="@(i => i.Key)"
                                        GetValue="@(i => i.Value)"
                                        GetEnabled="@(i => i.Enabled)"
                                        SetKey="@((i, v) => i.Key = v)"
                                        SetValue="@((i, v) => i.Value = v)"
                                        SetEnabled="@((i, v) => i.Enabled = v)"/>
                    }
                    else
                    {
                        <MonacoEditor Id="@($"request-body-editor-{_request.BodyType}")"
                                      Value="@_request.Body"
                                      ValueChanged="OnBodyChanged"
                                      Language="@_request.BodyType"
                                      ReadOnly="false"
                                      IsDarkMode="Layout.IsDarkMode"
                                      ShowMinimap="false"
                                      CssClass="request-body-editor"/>
                    }
                }
            </MudStack>
        </MudTabPanel>

        <!-- Auth Tab -->
        <MudTabPanel Text="Auth">
            <MudStack Spacing="3">
                <MudSelect T="AuthType" @bind-Value="_request.AuthType" Label="Auth Type" Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="AuthType.None">No Auth</MudSelectItem>
                    <MudSelectItem Value="AuthType.Bearer">Bearer Token</MudSelectItem>
                    <MudSelectItem Value="AuthType.Basic">Basic Auth</MudSelectItem>
                    <MudSelectItem Value="AuthType.ApiKey">API Key</MudSelectItem>
                    <MudSelectItem Value="AuthType.OAuth2">OAuth 2.0</MudSelectItem>
                </MudSelect>

                @switch (_request.AuthType)
                {
                    case AuthType.Bearer:
                        <MudTextField T="string"
                                      @bind-Value="_request.AuthToken"
                                      Label="Token"
                                      Placeholder="Enter bearer token"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Password"/>
                        break;

                    case AuthType.Basic:
                        <MudTextField T="string"
                                      @bind-Value="_request.AuthUsername"
                                      Label="Username"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>
                        <MudTextField T="string"
                                      @bind-Value="_request.AuthPassword"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Password"/>
                        break;

                    case AuthType.ApiKey:
                        <MudTextField T="string"
                                      @bind-Value="_request.ApiKeyName"
                                      Label="Key Name"
                                      Placeholder="e.g. X-API-Key"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>
                        <MudTextPasswordField @bind-Value="_request.ApiKeyValue" Label="Key Value"/>
                        <MudSelect T="ApiKeyLocation" @bind-Value="_request.ApiKeyLocation" Label="Add to"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="ApiKeyLocation.Header">Header</MudSelectItem>
                            <MudSelectItem Value="ApiKeyLocation.QueryParam">Query Param</MudSelectItem>
                        </MudSelect>
                        break;

                    case AuthType.OAuth2:
                        <MudSelect T="OAuth2GrantType" @bind-Value="_request.OAuth2GrantType" Label="Grant Type"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="OAuth2GrantType.ClientCredentials">Client Credentials</MudSelectItem>
                        </MudSelect>

                        <MudTextField T="string"
                                      @bind-Value="_request.OAuth2TokenUrl"
                                      Label="Token URL"
                                      Placeholder="https://auth.example.com/oauth2/token"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>

                        <MudTextField T="string"
                                      @bind-Value="_request.OAuth2ClientId"
                                      Label="Client ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>

                        <MudTextPasswordField @bind-Value="_request.OAuth2ClientSecret" Label="Client Secret"/>

                        <MudTextField T="string"
                                      @bind-Value="_request.OAuth2Scope"
                                      Label="Scope"
                                      Placeholder="e.g. read write"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>
                        
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTextField T="string"
                                          @bind-Value="_request.AuthToken"
                                          Label="Access Token"
                                          Placeholder="Access token will appear here"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true"
                                          Style="flex: 1;"/>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="GetOAuth2Token"
                                       Disabled="_isGettingToken">
                                @if (_isGettingToken)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                }
                                Get Token
                            </MudButton>
                        </MudStack>
                        break;
                }
            </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {

    [Parameter] public EventCallback<HttpResponseModel> OnResponseReceived { get; set; }
    [Parameter] public EventCallback<bool> OnSendingChanged { get; set; }
    [CascadingParameter] public required MainLayout Layout { get; set; }

    private HttpRequestModel _request = new();
    private bool _isSending;
    private bool _isGettingToken;
    private CancellationTokenSource? _cts;
    private MudTextField<string>? _urlField;
    private bool _showUrlPreview;
    private string? _resolvedUrlPreview;

    public async void LoadRequest(HttpRequestModel request)
    {
        _request = request.Clone(newId: false);
        await UpdateUrlPreview();
        StateHasChanged();
    }

    private async Task OnSendRequest(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
            return;
        await SendRequest();
    }

    private async Task SendRequest()
    {
        if (string.IsNullOrWhiteSpace(_request.Url))
            return;
        if (_isSending)
            return;

        _isSending = true;
        await OnSendingChanged.InvokeAsync(true);
        _cts = new CancellationTokenSource();

        try
        {
            // Substitute environment variables in headers
            var substitutedHeaders = new List<HeaderItem>();
            foreach (var h in _request.Headers)
            {
                substitutedHeaders.Add(new HeaderItem
                {
                    Key = h.Key,
                    Value = await EnvironmentService.SubstituteVariablesAsync(h.Value),
                    Enabled = h.Enabled
                });
            }

            // Substitute environment variables in query params
            var substitutedQueryParams = new List<QueryParamItem>();
            foreach (var q in _request.QueryParams)
            {
                substitutedQueryParams.Add(new QueryParamItem
                {
                    Key = q.Key,
                    Value = await EnvironmentService.SubstituteVariablesAsync(q.Value),
                    Enabled = q.Enabled
                });
            }

            // Substitute environment variables in form data
            var substitutedFormData = new List<FormDataItem>();
            foreach (var f in _request.FormData)
            {
                substitutedFormData.Add(new FormDataItem
                {
                    Key = f.Key,
                    Value = await EnvironmentService.SubstituteVariablesAsync(f.Value),
                    Enabled = f.Enabled,
                    IsFile = f.IsFile,
                    FileName = f.FileName,
                    ContentType = f.ContentType
                });
            }

            // Build fully substituted request
            var substitutedRequest = _request.Clone(newId: false);
            substitutedRequest.Url = await EnvironmentService.SubstituteVariablesAsync(_request.Url);
            substitutedRequest.Headers = substitutedHeaders;
            substitutedRequest.QueryParams = substitutedQueryParams;
            substitutedRequest.FormData = substitutedFormData;
            substitutedRequest.Body = await EnvironmentService.SubstituteVariablesAsync(_request.Body);
            substitutedRequest.AuthToken = await EnvironmentService.SubstituteVariablesAsync(_request.AuthToken);
            substitutedRequest.AuthUsername = await EnvironmentService.SubstituteVariablesAsync(_request.AuthUsername);
            substitutedRequest.AuthPassword = await EnvironmentService.SubstituteVariablesAsync(_request.AuthPassword);
            substitutedRequest.ApiKeyValue = await EnvironmentService.SubstituteVariablesAsync(_request.ApiKeyValue);
            substitutedRequest.OAuth2TokenUrl = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2TokenUrl);
            substitutedRequest.OAuth2ClientId = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2ClientId);
            substitutedRequest.OAuth2ClientSecret = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2ClientSecret);
            substitutedRequest.OAuth2Scope = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2Scope);

            // Set content type based on body type
            substitutedRequest.ContentType = _request.BodyType switch
            {
                "json" => "application/json",
                "xml" => "application/xml",
                "text" => "text/plain",
                "form-data" => "multipart/form-data",
                _ => _request.ContentType
            };

            var response = await ApiService.SendRequestAsync(substitutedRequest, _cts.Token);

            // Add to history
            await HistoryService.AddToHistoryAsync(_request, response);

            await OnResponseReceived.InvokeAsync(response);
        }
        finally
        {
            _isSending = false;
            await OnSendingChanged.InvokeAsync(false);
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void CancelRequest()
    {
        _cts?.Cancel();
    }

    private async Task GetOAuth2Token()
    {
        if (string.IsNullOrWhiteSpace(_request.OAuth2TokenUrl))
        {
            Snackbar.Add("Token URL is required.", Severity.Error);
            return;
        }

        _isGettingToken = true;
        StateHasChanged();

        try
        {
            var substitutedRequest = _request.Clone(newId: false);
            substitutedRequest.OAuth2TokenUrl = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2TokenUrl);
            substitutedRequest.OAuth2ClientId = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2ClientId);
            substitutedRequest.OAuth2ClientSecret = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2ClientSecret);
            substitutedRequest.OAuth2Scope = await EnvironmentService.SubstituteVariablesAsync(_request.OAuth2Scope);

            var token = await ApiService.GetOAuth2TokenAsync(substitutedRequest);
            _request.AuthToken = token;
            Snackbar.Add("Token retrieved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error retrieving token: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGettingToken = false;
            StateHasChanged();
        }
    }

    private async Task OnUrlChanged()
    {
        // Parse query params from URL
        if (string.IsNullOrWhiteSpace(_request.Url)) return;

        var questionMarkIndex = _request.Url.IndexOf('?');
        if (questionMarkIndex < 0) return;

        var queryString = _request.Url[(questionMarkIndex + 1)..];
        _request.Url = _request.Url[..questionMarkIndex];
        _request.QueryParams.Clear();

        if (_urlField is not null)
        {
            await _urlField.SetTextAsync($"{_request.Url}");
        }

        foreach (var pair in queryString.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            _request.QueryParams.Add(new QueryParamItem
            {
                Key = Uri.UnescapeDataString(parts[0]),
                Value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty,
                Enabled = true
            });
        }
    }

    private Task OnQueryParamsChanged(List<QueryParamItem> items)
    {
        _request.QueryParams = items;
        return Task.CompletedTask;
    }

    private Task OnHeadersChanged(List<HeaderItem> items)
    {
        _request.Headers = items;
        return Task.CompletedTask;
    }

    private Task OnFormDataChanged(List<FormDataItem> items)
    {
        _request.FormData = items;
        return Task.CompletedTask;
    }

    private void AddCommonHeader(string key, string value)
    {
        if (!_request.Headers.Any(h => h.Key.Equals(key, StringComparison.OrdinalIgnoreCase)))
        {
            _request.Headers.Add(new HeaderItem { Key = key, Value = value, Enabled = true });
        }
    }

    private void FormatJson()
    {
        if (string.IsNullOrWhiteSpace(_request.Body)) return;
        try
        {
            var parsed = System.Text.Json.JsonDocument.Parse(_request.Body);
            _request.Body = System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            // Invalid JSON, leave as-is
        }
    }

    private string? GetParamsBadge() =>
        _request.QueryParams.Count(p => p.Enabled && !string.IsNullOrWhiteSpace(p.Key)) is > 0 and var count
            ? count.ToString()
            : null;

    private string? GetHeadersBadge() =>
        _request.Headers.Count(h => h.Enabled && !string.IsNullOrWhiteSpace(h.Key)) is > 0 and var count
            ? count.ToString()
            : null;

    private void OnBodyChanged(string value)
    {
        _request.Body = value;
    }

    private async Task SaveToCollection()
    {
        var parameters = new DialogParameters<SaveToCollectionDialog>
        {
            { x => x.Request, _request }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SaveToCollectionDialog>("Save to Collection", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false && result.Data is SaveToCollectionDialog.SaveToCollectionResult saveResult)
        {
            await CollectionService.AddRequestToCollectionAsync(
                saveResult.CollectionId,
                saveResult.RequestName,
                _request);
        }
    }

    protected override void OnInitialized()
    {
        EnvironmentService.OnEnvironmentChanged += OnEnvironmentChanged;
    }

    private async void OnEnvironmentChanged()
    {
        await UpdateUrlPreview();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnUrlValueChanged(string value)
    {
        _request.Url = value;
        await UpdateUrlPreview();
    }

    private async Task UpdateUrlPreview()
    {
        if (!EnvironmentService.ContainsVariables(_request.Url))
        {
            _showUrlPreview = false;
            _resolvedUrlPreview = null;
            return;
        }

        _resolvedUrlPreview = await EnvironmentService.SubstituteVariablesAsync(_request.Url);
        _showUrlPreview = _resolvedUrlPreview != _request.Url;
    }

    public void Dispose()
    {
        EnvironmentService.OnEnvironmentChanged -= OnEnvironmentChanged;
    }

}
