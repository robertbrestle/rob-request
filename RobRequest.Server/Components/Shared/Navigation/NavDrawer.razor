@inject CurrentUserService CurrentUser

@if (IsEnabled)
{
    <MudDrawer Open="IsDrawerOpen" OpenChanged="IsDrawerOpenChanged" Elevation="2" ClipMode="DrawerClipMode.Always"
               Width="300px" Class="drawer-container" Variant="DrawerVariant.Mini">
        @* mini drawer menu *@
        @if (!IsDrawerOpen)
        {
            <MudStack Spacing="3" Class="pt-3">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Size="Size.Small"
                               OnClick="OnDrawerToggle"
                               aria-label="toggle drawer"/>
                <MudDivider/>
                <MudIconButton Icon="@Icons.Material.Filled.Home"
                               Size="Size.Small"
                               Href="/"
                               aria-label="go home"
                               title="Home"/>
                <MudIconButton Icon="@Icons.Material.Filled.Folder"
                               Size="Size.Small"
                               Href="/collections"
                               aria-label="open collections"
                               title="Collections"/>
                <MudIconButton Icon="@Icons.Material.Filled.Dns"
                               Size="Size.Small"
                               Href="/environments"
                               aria-label="open environments"
                               title="Environments"/>
                <MudDivider/>
                <MudIconButton Icon="@Icons.Material.Filled.Info"
                               Size="Size.Small"
                               OnClick="OnAboutDialog"
                               aria-label="open about dialog"
                               title="About"/>
                <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Size="Size.Small"
                               OnClick="OnToggleDarkMode"
                               aria-label="change theme"
                               title="Theme"/>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Size="Size.Small"
                               Href="/settings"
                               aria-label="open settings"
                               title="Settings"/>
                <AuthorizeView Policy="Admin">
                    <Authorized>
                        <MudDivider/>
                        <MudIconButton Icon="@Icons.Material.Filled.AssuredWorkload"
                                       Size="Size.Small"
                                       Href="/admin/users"
                                       aria-label="open user management"
                                       title="User Management"/>
                    </Authorized>
                </AuthorizeView>
                <MudDivider/>
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Size="Size.Small"
                               Href="/api/auth/logout"
                               aria-label="logout"
                               title="Logout"/>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3" Class="pt-2" Justify="Justify.FlexStart">

                <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Class="pl-4">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Size="Size.Small"
                                   OnClick="OnDrawerToggle"
                                   aria-label="toggle drawer"/>
                    <MudLink Href="/" Color="Color.Inherit">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudImage Src="/favicon.png" Height="24"/>
                            <MudText Typo="Typo.h6" Class="mr-4">
                                <b>RobRequest</b>
                            </MudText>
                        </MudStack>
                    </MudLink>
                    <MudSpacer/>
                    @if (IsNavMenuEnabled)
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Class="pr-2" Size="Size.Small"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Home"
                                         Href="/">
                                Home
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Folder"
                                         Href="/collections">
                                Collections
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Dns"
                                         Href="/environments">
                                Environments
                            </MudMenuItem>
                            <MudDivider/>
                            <MudMenuItem Icon="@Icons.Material.Filled.Info"
                                         OnClick="OnAboutDialog">
                                About
                            </MudMenuItem>
                            <MudMenuItem
                                Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                OnClick="OnToggleDarkMode">
                                Theme
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                         Href="/settings">
                                Settings
                            </MudMenuItem>
                            <AuthorizeView Policy="Admin">
                                <Authorized>
                                    <MudDivider/>
                                    <MudMenuItem Icon="@Icons.Material.Filled.AssuredWorkload"
                                                 Href="/admin/users">
                                        User Management
                                    </MudMenuItem>
                                </Authorized>
                            </AuthorizeView>
                            <MudDivider/>
                            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                         Href="/api/auth/logout"
                                         ForceLoad="true">
                                Logout (@CurrentUser.Username)
                            </MudMenuItem>
                        </MudMenu>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Custom.Uncategorized.Empty"
                                 Size="Size.Small"
                                 Disabled="true"/>
                    }
                </MudStack>

                @* expanded drawer with section *@
                @if (IsDrawerSectionEnabled)
                {
                    <SectionOutlet SectionName="Drawer"/>
                }
                else
                {
                    <MudDivider/>
                    <MudButton StartIcon="@Icons.Material.Filled.Home"
                               Class="justify-start pl-4"
                               Href="/"
                               aria-label="go home"
                               title="Home">
                        Home
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Folder"
                               Class="justify-start pl-4"
                               Href="/collections"
                               aria-label="open collections"
                               title="Collections">
                        Collections
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Dns"
                               Class="justify-start pl-4"
                               Href="/environments"
                               aria-label="open environments"
                               title="Environments">
                        Environments
                    </MudButton>
                    <MudDivider/>
                    <MudButton StartIcon="@Icons.Material.Filled.Info"
                               Class="justify-start pl-4"
                               OnClick="OnAboutDialog"
                               aria-label="open about dialog"
                               title="About">
                        About
                    </MudButton>
                    <MudButton
                        StartIcon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                        Class="justify-start pl-4"
                        OnClick="OnToggleDarkMode"
                        aria-label="change theme"
                        title="Theme">
                        Theme
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Settings"
                               Class="justify-start pl-4"
                               Href="/settings"
                               aria-label="open settings"
                               title="Settings">
                        Settings
                    </MudButton>
                    <AuthorizeView Policy="Admin">
                        <Authorized>
                            <MudDivider/>
                            <MudButton StartIcon="@Icons.Material.Filled.AssuredWorkload"
                                       Class="justify-start pl-4"
                                       Href="/admin/users"
                                       aria-label="open user management"
                                       title="User Management">
                                User Management
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                    <MudDivider/>
                    <MudButton StartIcon="@Icons.Material.Filled.Logout"
                               Class="justify-start pl-4"
                               Href="/api/auth/logout"
                               aria-label="logout"
                               title="Logout">
                        Logout
                    </MudButton>
                }
            </MudStack>
        }
    </MudDrawer>
}

@code {
    [Parameter] public bool IsEnabled { get; set; }
    [Parameter] public bool IsDrawerOpen { get; set; }
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public bool IsNavMenuEnabled { get; set; } = true;
    [Parameter] public bool IsDrawerSectionEnabled { get; set; } = true;
    [Parameter] public EventCallback<bool> IsDrawerOpenChanged { get; set; }
    [Parameter] public EventCallback OnToggleDarkMode { get; set; }
    [Parameter] public EventCallback OnDrawerToggle { get; set; }
    [Parameter] public EventCallback OnAboutDialog { get; set; }
}
