@inject EnvironmentService EnvironmentService
@implements IDisposable

<MudSelect T="string"
           Value="_activeId"
           ValueChanged="OnEnvironmentSelected"
           Variant="Variant.Outlined"
           Dense="true"
           Margin="Margin.Dense"
           Label="Environment"
           OuterClass="environment-selector pa-2"
           title="Select environment"
           aria-label="select environment">
    @foreach (var env in _environments)
    {
        <MudSelectItem Value="@env.Id">@env.Name</MudSelectItem>
    }
</MudSelect>

@code {

    private List<EnvironmentModel> _environments = new();
    private string? _activeId;

    protected override async Task OnInitializedAsync()
    {
        await EnvironmentService.InitializeAsync();
        _environments = await EnvironmentService.GetAllEnvironmentsAsync();
        _activeId = EnvironmentService.ActiveEnvironmentId;
        EnvironmentService.OnEnvironmentChanged += OnChanged;
    }

    private async void OnChanged()
    {
        _environments = await EnvironmentService.GetAllEnvironmentsAsync();
        _activeId = EnvironmentService.ActiveEnvironmentId;
        await InvokeAsync(StateHasChanged);
    }

    private void OnEnvironmentSelected(string? id)
    {
        EnvironmentService.ActiveEnvironmentId = id;
    }

    public void Dispose()
    {
        EnvironmentService.OnEnvironmentChanged -= OnChanged;
    }

}