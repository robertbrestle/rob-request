@using global::MudBlazor
<div class="d-flex">
    <MudTextField @bind-Value="Value" Label="@Label" Variant="@Variant" InputType="@_passwordInput"
                  Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="ButtonTestclick"
                  AdornmentAriaLabel="Show Secret"/>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Label { get; set; } = "Field";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    private bool _isShow;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ButtonTestclick()
    {
        @if (_isShow)
        {
            _isShow = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isShow = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

}