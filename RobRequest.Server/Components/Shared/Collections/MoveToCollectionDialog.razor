@using Collections = RobRequest.Shared.Models.Collections.Collection
@inject CollectionService CollectionService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">
                Move "<b>@RequestName</b>" to:
            </MudText>

            @if (_collections.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Default">
                    No other collections available.
                </MudText>
            }
            else
            {
                <MudStack Spacing="0"
                          Style="max-height: 300px; overflow-y: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; padding: 4px;">
                    @foreach (var collection in _collections)
                    {
                        @CollectionOption(collection, 0)
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="string.IsNullOrWhiteSpace(_selectedCollectionId)">
            Move
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string? CurrentCollectionId { get; set; }
    [Parameter] public string RequestName { get; set; } = string.Empty;

    private List<Collections> _collections = new();
    private string? _selectedCollectionId;

    protected override async Task OnInitializedAsync()
    {
        _collections = await CollectionService.GetCollectionTreeAsync();
    }

    private void SelectCollection(string collectionId)
    {
        _selectedCollectionId = collectionId;
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_selectedCollectionId)) return;
        MudDialog.Close(DialogResult.Ok(_selectedCollectionId));
    }

    private void Cancel() => MudDialog.Cancel();

    private RenderFragment CollectionOption(Collections collection, int depth) => __builder =>
    {
        var isSelected = _selectedCollectionId == collection.Id;
        var isCurrent = collection.Id == CurrentCollectionId;

        <MudStack Row="true" AlignItems="AlignItems.Center"
                  Class="@($"pa-1 {(isSelected ? "mud-primary-text" : "")} {(isCurrent ? "mud-text-disabled" : "")}")"
                  Style="@($"padding-left: {depth * 20}px; cursor: {(isCurrent ? "default" : "pointer")}; border-radius: 4px; {(isSelected ? "background: var(--mud-palette-primary-lighten); " : "")}")"
                  @onclick="() => { if (!isCurrent) SelectCollection(collection.Id); }">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Warning"/>
            <MudText Typo="Typo.body2">
                @collection.Name
                @if (isCurrent)
                {
                    <span> (current)</span>
                }
            </MudText>
            @if (isSelected)
            {
                <MudSpacer/>
                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"/>
            }
        </MudStack>

        @foreach (var child in collection.Children)
        {
            @CollectionOption(child, depth + 1)
        }
    };

}