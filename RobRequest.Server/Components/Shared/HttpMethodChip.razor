<MudChip T="string" Color="@GetMethodColor()" Size="@Size" Variant="@Variant">
    <MudText Typo="Typo.caption" Color="@GetMethodTextColor()">
        <b>@Method</b>
    </MudText>
</MudChip>

@code {
    [Parameter] public string? Method { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public MudBlazor.Size Size { get; set; } = Size.Small;
    [Parameter] public MudBlazor.Variant Variant { get; set; } = Variant.Filled;

    private Color GetMethodColor()
    {
        if (IsError)
            return Color.Error;
        return Method switch
        {
            "GET" => Color.Success,
            "POST" => Color.Warning,
            "PUT" => Color.Info,
            "PATCH" => Color.Secondary,
            "DELETE" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetMethodTextColor()
    {
        if (IsError)
            return Color.Dark;
        return Method switch
        {
            "GET" => Color.Default,
            "POST" => Color.Dark,
            "PUT" => Color.Default,
            "PATCH" => Color.Dark,
            "DELETE" => Color.Dark,
            _ => Color.Default
        };
    }
}