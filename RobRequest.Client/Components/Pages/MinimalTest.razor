@page "/minimal-test"
@rendermode InteractiveWebAssembly

<PageTitle>Minimal MudBlazor Test</PageTitle>

<h3>Minimal Test - No Custom Services</h3>

<MudText Typo="Typo.h6">Basic Components:</MudText>

<MudSelect T="string" Label="Simple Select" Variant="Variant.Outlined">
    <MudSelectItem Value="@("a")">Option A</MudSelectItem>
    <MudSelectItem Value="@("b")">Option B</MudSelectItem>
    <MudSelectItem Value="@("c")">Option C</MudSelectItem>
</MudSelect>

<br/>

<MudButton Variant="Variant.Filled" Color="Color.Primary">Simple Button</MudButton>

<br/>

<MudTextField @bind-Value="simpleText" Label="Simple Text" Variant="Variant.Outlined" />

<br/>

<p>Text value: @simpleText</p>

@code {
    private string simpleText = "";
}
