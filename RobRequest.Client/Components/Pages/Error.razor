@page "/Error"
@using System.Diagnostics

<PageTitle>Error - RobRequest</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" Color="Color.Error" GutterBottom="true">Error</MudText>
        <MudText Typo="Typo.body1" GutterBottom="true">An error occurred while processing your request.</MudText>

        @if (ShowRequestId)
        {
            <MudText Typo="Typo.body2" Class="mt-2">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </MudText>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2" Color="Color.Default">
            Swapping to the Development environment will display more detailed information about the error.
        </MudText>

        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
            Return Home
        </MudButton>
    </MudPaper>
</MudContainer>

@code{
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id;
}
