<MudSelect T="string"
           Value="Value"
           ValueChanged="HandleValueChanged"
           Variant="Variant.Outlined"
           Dense="true"
           Style="min-width: 130px; max-width: 140px;"
           Class="method-selector">
    @foreach (var method in StandardMethods)
    {
        <MudSelectItem Value="@method">
            <MudText Color="@GetMethodColor(method)" Typo="Typo.body2">
                <b>@method</b>
            </MudText>
        </MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public string Value { get; set; } = "GET";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private static readonly string[] StandardMethods = { "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS" };

    private Color GetMethodColor(string method) => method switch
    {
        "GET" => Color.Success,
        "POST" => Color.Warning,
        "PUT" => Color.Info,
        "PATCH" => Color.Secondary,
        "DELETE" => Color.Error,
        "HEAD" => Color.Dark,
        "OPTIONS" => Color.Dark,
        _ => Color.Default
    };

    private async Task HandleValueChanged(string method)
    {
        if (!string.Equals(Value, method, StringComparison.Ordinal))
        {
            Value = method;
            await ValueChanged.InvokeAsync(method);
        }
    }
}
