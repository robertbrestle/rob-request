<Router AppAssembly="typeof(RobRequest.Client.Components.Pages.Home).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(RobRequest.Client.Components.Layout.MainLayout)"/>
        <FocusOnNavigate RouteData="routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(RobRequest.Client.Components.Layout.MainLayout)">
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mt-8">Page Not Found</MudText>
        </LayoutView>
    </NotFound>
</Router>