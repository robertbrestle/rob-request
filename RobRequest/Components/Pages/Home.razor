@page "/"
@rendermode InteractiveWebAssembly
@inject SettingsService SettingsService

<PageTitle>RobRequest - API Client</PageTitle>

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />
        <MudIcon Icon="@Icons.Material.Filled.Api" Class="mr-2" />
        <MudText Typo="Typo.h6" Class="mr-4">RobRequest</MudText>
        <MudSpacer />
        <EnvironmentSelector />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode"
                       Class="ml-2" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                       Color="Color.Inherit"
                       Href="/settings"
                       Class="ml-1" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Width="320px">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">History</MudText>
        </MudDrawerHeader>
        <Sidebar OnRequestSelected="OnHistoryItemSelected" />
    </MudDrawer>

    <MudMainContent Class="pa-4" Style="min-height: calc(100vh - 48px);">
        <RequestPanel @ref="_requestPanel"
                      OnResponseReceived="OnResponseReceived"
                      OnSendingChanged="OnSendingChanged" />
        <ResponsePanel Response="_response" IsSending="_isSending" />
    </MudMainContent>
</MudLayout>

@code {
    private RequestPanel? _requestPanel;
    private HttpResponseModel? _response;
    private bool _isSending;
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#FF9800",
            AppbarBackground = "#1976D2",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#424242",
            DrawerIcon = "#616161"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#90CAF9",
            Secondary = "#FFB74D",
            AppbarBackground = "#1E1E2E",
            Background = "#121212",
            Surface = "#1E1E2E",
            DrawerBackground = "#1E1E2E",
            DrawerText = "#E0E0E0",
            DrawerIcon = "#BDBDBD"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _isDarkMode = settings.DarkMode;
        SettingsService.OnSettingsChanged += OnSettingsChanged;
    }

    private async void OnSettingsChanged()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _isDarkMode = settings.DarkMode;
        await InvokeAsync(StateHasChanged);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        var settings = await SettingsService.GetSettingsAsync();
        settings.DarkMode = _isDarkMode;
        await SettingsService.UpdateSettingsAsync(settings);
    }

    private void OnResponseReceived(HttpResponseModel response)
    {
        _response = response;
        StateHasChanged();
    }

    private void OnSendingChanged(bool isSending)
    {
        _isSending = isSending;
        StateHasChanged();
    }

    private void OnHistoryItemSelected(HistoryItem item)
    {
        if (item.Request != null)
        {
            _requestPanel?.LoadRequest(item.Request);
        }
        if (item.Response != null)
        {
            _response = item.Response;
            StateHasChanged();
        }
    }
}
